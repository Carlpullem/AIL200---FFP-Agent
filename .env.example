# Gridiron Edge AI — Environment Template (Zero Hardcoded Secrets)
# In production, secrets are loaded dynamically via Google Cloud Secret Manager (`ffp_agent/secrets.py`).

GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_API_KEY=resolved-via-gcp-secret-manager
VERTEX_AI_AGENT_ENGINE_ID=optional-agent-engine-id
ENABLE_CLOUD_TRACE=false
ENABLE_CLOUD_DLP=false
PORT=8080
